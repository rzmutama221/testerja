# ===========================================================
# rzdkstore.my.id — Environment Variables
# ===========================================================
# Copy file ini menjadi .env dan isi sesuai konfigurasi Anda

# --- DATABASE ---
DATABASE_URL="mysql://user:password@localhost:3306/rzdkstore"

# --- NEXTAUTH ---
NEXTAUTH_SECRET="ganti-dengan-random-string-32-karakter"
NEXTAUTH_URL="https://rzdkstore.my.id"

# --- EMAIL (SMTP) ---
SMTP_HOST="mail.rzdkstore.my.id"
SMTP_PORT=465
SMTP_USER="noreply@rzdkstore.my.id"
SMTP_PASS="ganti-dengan-password-email"
SMTP_FROM="rzdkstore <noreply@rzdkstore.my.id>"

# --- WEB PUSH (VAPID) ---
# Generate dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:admin@rzdkstore.my.id"

# --- PAYMENT GATEWAY (Opsional) ---
PAYMENT_GATEWAY_PROVIDER=""
PAYMENT_GATEWAY_API_KEY=""
PAYMENT_GATEWAY_SECRET_KEY=""

# --- ENCRYPTION ---
# Random 32 character string untuk enkripsi data sensitif di DB
ENCRYPTION_KEY="ganti-dengan-random-string-32-chars"

# --- APP ---
NEXT_PUBLIC_APP_URL="https://rzdkstore.my.id"
NEXT_PUBLIC_APP_NAME="rzdkstore"
NEXT_PUBLIC_WA_NUMBER="6285111642004"
